{
    "compilerOptions": {
        "target": "es2020",
        "strict": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "noEmit": true,
        "downlevelIteration": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules/*",
        "dist",
        "main.js"
    ]
}